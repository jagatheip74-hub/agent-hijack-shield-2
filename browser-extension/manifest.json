{
  "manifest_version": 3,
  "name": "Agent Hijack Shield for ChatGPT",
  "version": "0.1.0",
  "description": "Hold supported ChatGPT text-file uploads for local scan and policy authorization.",
  "permissions": [],
  "host_permissions": [
    "https://chatgpt.com/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}