{
  "manifest_version": 3,
  "name": "Agent Hijack Shield for AI Chats",
  "version": "1.1.0",
  "description": "Checks prompts in ChatGPT, Gemini, and Claude with the local Agent Hijack Shield scanner before sending.",
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://claude.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
